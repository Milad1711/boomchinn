# ─────────────────────────────────────────────────────────────
# بوم چین — Environment variables
# ─────────────────────────────────────────────────────────────

# ۱) توسعه‌ی محلی (SQLite file) — پیش‌فرض همین کافی است
DATABASE_URL="file:./db/custom.db"

# ۲) استقرار روی Vercel + Turso — این دو مقدار را در داشبورد Vercel
#    (Settings → Environment Variables) وارد کنید و خط بالا را حذف کنید:
# DATABASE_URL="libsql://<db-name>-<your-org>.turso.io"
# DATABASE_AUTH_TOKEN="<token-from-turso>"

# ۳) رمز اولیه مدیر (ورود به پنل مدیریت فقط با رمز انجام می‌شود)
#    بعد از اولین ورود، پنل اجباری می‌کند رمز را عوض کنید؛
#    رمز جدید هش‌شده در خود دیتابیس ذخیره می‌شود.
ADMIN_PASSWORD="<یک-رمز-قوی>"

# نکته: ساخت جداول روی دیتابیس تازه (محلی یا Turso) خودکار است —
# اولین درخواست API جدول‌ها را می‌سازد؛ نیازی به دستور migration نیست.
