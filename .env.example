# ─────────────────────────────────────────────────────────────
# بوم چین — Environment variables
# ─────────────────────────────────────────────────────────────

# ۱) توسعه‌ی محلی (SQLite file) — پیش‌فرض همین کافی است
DATABASE_URL="file:./db/custom.db"

# ۲) استقرار روی Vercel + Turso — این دو مقدار را در داشبورد Vercel
#    (Settings → Environment Variables) وارد کنید و خط بالا را حذف کنید:
# DATABASE_URL="libsql://<db-name>-<your-org>.turso.io"
# DATABASE_AUTH_TOKEN="<token-from: turso db tokens create <db-name>>"

# ۳) شناسه‌ی دستگاه مدیر (ورود به پنل مدیریت)
ADMIN_DEVICE_ID="<یک-uuid-تصادفی>"
