generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlayerProgress {
  id         String   @id // playerId (client generated uuid)
  name       String   @default("") // display name for the leaderboard (empty = unnamed)
  coins      Int      @default(100)
  stars      String   @default("{}") // JSON: { [levelIndex]: stars 0..3 }
  bestScores String   @default("{}") // JSON: { [levelIndex]: best score }
  items      String   @default("{}") // JSON: inventory { extraShot, bombShot, skins[], skin }
  settings   String   @default("{}") // JSON: { haptics, shadows }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}